---
import { Image } from 'astro:assets';
import bannerBg from '../assets/images/banner-bg.jpg';

interface Props {
  title: string;
  parent?: { label: string; href: string };
  lang?: 'pl' | 'en';
}

const { title, parent, lang = 'pl' } = Astro.props;

const labelOverrides: Record<string, string> = lang === 'en'
  ? { services: 'Products' }
  : { services: 'Oferta' };

const homeLabel = lang === 'en' ? 'Home' : 'Strona główna';

// Strip the /en locale prefix so it doesn't show up as its own breadcrumb segment.
const localeStrippedPath = lang === 'en'
  ? Astro.url.pathname.replace(/^\/en\/?/, '/')
  : Astro.url.pathname;
const pathPrefix = lang === 'en' ? '/en' : '';

const segments = localeStrippedPath
  .split('/')
  .filter(Boolean)
  .map((seg, i, arr) => ({
    label: labelOverrides[seg] ?? seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
    href: pathPrefix + '/' + arr.slice(0, i + 1).join('/'),
    isLast: i === arr.length - 1,
  }));

const siteOrigin = Astro.site ?? new URL('https://www.merplus.pl');
const breadcrumbTrail = [
  { name: homeLabel, href: lang === 'en' ? '/en' : '/' },
  ...(parent ? [{ name: parent.label, href: parent.href }] : []),
  ...segments.map(({ label, href }) => ({ name: label, href })),
];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbTrail.map(({ name, href }, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name,
    item: new URL(href, siteOrigin).href,
  })),
};
---

<section class="relative overflow-hidden bg-primary py-14 sm:py-16 lg:py-20">
  <Image
    src={bannerBg}
    alt=""
    class="absolute inset-0 size-full object-cover"
    widths={[640, 1280, 1920]}
    sizes="100vw"
    loading="eager"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/70 to-primary/30"></div>
  <div class="relative mx-auto max-w-site px-4 sm:px-6">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-primary-fg/60">
        <li>
          <a href={lang === 'en' ? '/en' : '/'} class="transition-colors hover:text-primary-fg">{homeLabel}</a>
        </li>
        {parent && (
          <li class="flex items-center gap-1.5">
            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <a href={parent.href} class="transition-colors hover:text-primary-fg">{parent.label}</a>
          </li>
        )}
        {segments.map(({ label, href, isLast }) => (
          <li class="flex items-center gap-1.5">
            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            {isLast ? (
              <span aria-current="page" class="text-primary-fg">{label}</span>
            ) : (
              <a href={href} class="transition-colors hover:text-primary-fg">{label}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <h1 class="font-heading text-h1 font-bold uppercase text-primary-fg">
      {title}
    </h1>

    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  </div>
</section>
