---
interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;

const faqsPl = [
  {
    question: 'Czy realizujecie małe zamówienia bez minimum?',
    answer:
      'Tak. Dzięki własnej produkcji jesteśmy w stanie zrealizować zarówno niewielkie, jednostkowe zamówienia, jak i duże nakłady produkcyjne dla firm. Skontaktuj się z nami, a dopasujemy ofertę do Twoich potrzeb.',
  },
  {
    question: 'Jak długo trwa realizacja toreb z nadrukiem?',
    answer:
      'Standardowy czas realizacji toreb z nadrukiem to zwykle od 3 dni roboczych, w zależności od nakładu, techniki nadruku i bieżącego obciążenia produkcji. Przy zapytaniu o wycenę podajemy dokładny termin dostawy.',
  },
  {
    question: 'Czy produkujecie torby reklamowe na całą Polskę?',
    answer:
      'Tak, realizujemy zamówienia i wysyłamy torby papierowe oraz opakowania reklamowe do klientów w całej Polsce. Produkcja odbywa się w naszym zakładzie w Sulejówku.',
  },
  {
    question: 'Czym różni się torba reklamowa od ozdobnej?',
    answer:
      'Torba reklamowa jest projektowana głównie pod kątem nadruku logo i grafiki firmowej — sprawdza się w marketingu, na eventach i w sklepach. Torba ozdobna kładzie nacisk na estetykę i wykończenie (np. ręczne zdobienia, wstążki, struktury papieru) i najczęściej służy jako opakowanie prezentowe.',
  },
];

const faqsEn = [
  {
    question: 'Do you take small orders with no minimum quantity?',
    answer:
      'Yes. Thanks to our own production facility we can handle everything from small, one-off orders to large production runs for companies. Get in touch and we\'ll tailor the offer to your needs.',
  },
  {
    question: 'How long does it take to produce printed paper bags?',
    answer:
      'Standard turnaround for printed bags is usually from 3 business days, depending on quantity, printing technique, and current production load. We confirm the exact delivery date when you request a quote.',
  },
  {
    question: 'Do you ship promotional paper bags across Poland and abroad?',
    answer:
      'Yes, we produce and ship paper bags and promotional packaging to customers across Poland and internationally. Production takes place at our own facility in Sulejówek, near Warsaw.',
  },
  {
    question: 'What is the difference between promotional and decorative bags?',
    answer:
      'Promotional bags are designed primarily for logo printing and brand graphics — they work well in marketing, at events, and in stores. Decorative bags focus on aesthetics and finish (hand-applied decorations, ribbons, textured papers) and are most often used as gift packaging.',
  },
];

const faqs = lang === 'en' ? faqsEn : faqsPl;
const heading = lang === 'en'
  ? { title: 'Frequently Asked Questions', subtitle: 'Answers to the questions we hear most often from our customers.' }
  : { title: 'Najczęściej zadawane pytania', subtitle: 'Odpowiedzi na pytania, które najczęściej słyszymy od naszych klientów.' };
---

<section class="py-section">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{heading.title}</h2>
      <p class="mt-3 text-text-muted leading-relaxed">
        {heading.subtitle}
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map(({ question, answer }) => (
        <details class="group rounded-lg border border-border bg-background p-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-h3 font-semibold text-text">
            {question}
            <svg class="size-5 shrink-0 text-primary transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </summary>
          <p class="mt-3 text-text-muted leading-relaxed">{answer}</p>
        </details>
      ))}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: answer,
      },
    })),
  })} />
</section>
