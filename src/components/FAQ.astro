---
const faqs = [
  {
    question: 'Czy realizujecie małe zamówienia bez minimum?',
    answer:
      'Tak. Dzięki własnej produkcji jesteśmy w stanie zrealizować zarówno niewielkie, jednostkowe zamówienia, jak i duże nakłady produkcyjne dla firm. Skontaktuj się z nami, a dopasujemy ofertę do Twoich potrzeb.',
  },
  {
    question: 'Jak długo trwa realizacja toreb z nadrukiem?',
    answer:
      'Standardowy czas realizacji toreb z nadrukiem to zwykle od 3 dni roboczych, w zależności od nakładu, techniki nadruku i bieżącego obciążenia produkcji. Przy zapytaniu o wycenę podajemy dokładny termin dostawy.',
  },
  {
    question: 'Czy produkujecie torby reklamowe na całą Polskę?',
    answer:
      'Tak, realizujemy zamówienia i wysyłamy torby papierowe oraz opakowania reklamowe do klientów w całej Polsce. Produkcja odbywa się w naszym zakładzie w Sulejówku.',
  },
  {
    question: 'Czym różni się torba reklamowa od ozdobnej?',
    answer:
      'Torba reklamowa jest projektowana głównie pod kątem nadruku logo i grafiki firmowej — sprawdza się w marketingu, na eventach i w sklepach. Torba ozdobna kładzie nacisk na estetykę i wykończenie (np. ręczne zdobienia, wstążki, struktury papieru) i najczęściej służy jako opakowanie prezentowe.',
  },
];
---

<section class="py-section">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <h2 class="font-heading text-h2 font-bold uppercase text-text">Najczęściej zadawane pytania</h2>
      <p class="mt-3 text-text-muted leading-relaxed">
        Odpowiedzi na pytania, które najczęściej słyszymy od naszych klientów.
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map(({ question, answer }) => (
        <details class="group rounded-lg border border-border bg-background p-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-h3 font-semibold text-text">
            {question}
            <svg class="size-5 shrink-0 text-primary transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </summary>
          <p class="mt-3 text-text-muted leading-relaxed">{answer}</p>
        </details>
      ))}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: answer,
      },
    })),
  })} />
</section>
