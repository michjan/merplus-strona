---
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import { client } from '../data/client';
import logo from '../assets/images/logo_wb merplus.png';
import { plToEn, enToPl } from '../i18n/page-map';

interface Props {
  lang?: 'pl' | 'en';
}

const { lang = 'pl' } = Astro.props;

const offerLinksPl = [
  { label: 'Torby reklamowe',    href: '/torby-reklamowe' },
  { label: 'Torby z logo',       href: '/torby-reklamowe-z-logo' },
  { label: 'Torby ozdobne',      href: '/torby-ozdobne' },
  { label: 'Pudełka prezentowe', href: '/pudelka-prezentowe' },
  { label: 'Torby na alkohol',   href: '/torby-na-alkohol' },
  { label: 'Torby eko',          href: '/torby-eko' },
];

const offerLinksEn = [
  { label: 'Promotional bags',   href: plToEn['/torby-reklamowe'] },
  { label: 'Custom logo bags',   href: plToEn['/torby-reklamowe-z-logo'] },
  { label: 'Decorative bags',    href: plToEn['/torby-ozdobne'] },
  { label: 'Gift boxes',         href: plToEn['/pudelka-prezentowe'] },
  { label: 'Wine gift bags',     href: plToEn['/torby-na-alkohol'] },
  { label: 'Eco-friendly bags',  href: plToEn['/torby-eko'] },
];


const navPl = [
  { label: 'Strona główna', href: '/' },
  { label: 'O nas',         href: '/about' },
  { label: 'Oferta',        href: '/services', children: offerLinksPl },
  { label: 'Wykrojniki',    href: '/wykrojniki' },
  { label: 'Blog',          href: '/blog' },
  { label: 'Kontakt',       href: '/contact' },
];

const navEn = [
  { label: 'Home',    href: plToEn['/'] },
  { label: 'About',   href: plToEn['/about'] },
  { label: 'Products', href: plToEn['/services'], children: offerLinksEn },
  { label: 'Size guide', href: plToEn['/wykrojniki'] },
  { label: 'Blog',    href: '/en/blog' },
  { label: 'Contact', href: plToEn['/contact'] },
];

const nav = lang === 'en' ? navEn : navPl;
const contactHref = lang === 'en' ? plToEn['/contact'] : '/contact';
const quoteLabel = lang === 'en' ? 'Get a free quote' : 'Bezpłatna wycena';
const fullOfferLabel = lang === 'en' ? 'All products' : 'Cała oferta';

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.replace(/\/$/, '') || '/';
const switchHref = lang === 'en'
  ? (enToPl[normalizedPath] ?? '/')
  : (plToEn[normalizedPath] ?? '/en');
const switchLabel = lang === 'en' ? 'PL' : 'EN';
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-sm"
  transition:persist={`header-${lang}`}
>
  <div class="mx-auto flex max-w-site items-center justify-between px-4 py-3 sm:px-6">
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center transition-opacity hover:opacity-80"
      aria-label={brand.name}
    >
      <Image src={logo} alt={brand.name} class="h-9 w-auto sm:h-10" widths={[120, 240]} />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      {nav.map(({ label, href, children }) => {
        const isActive =
          currentPath === href ||
          (href !== '/' && currentPath.startsWith(href)) ||
          (children?.some((c) => currentPath === c.href || currentPath.startsWith(c.href)) ?? false);

        if (children) {
          return (
            <div class="group relative">
              <a
                href={href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium transition-colors',
                  isActive
                    ? 'bg-primary/10 text-primary'
                    : 'text-text-muted hover:text-text',
                ]}
              >
                {label}
                <svg class="size-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              <div class="invisible absolute left-0 top-full z-50 w-56 rounded-lg border border-border bg-background p-2 opacity-0 shadow-lg transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                {children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      'block rounded-md px-3 py-2 text-sm font-medium transition-colors',
                      currentPath === child.href || currentPath.startsWith(child.href)
                        ? 'bg-primary/10 text-primary'
                        : 'text-text-muted hover:bg-surface hover:text-text',
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          );
        }

        return (
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive
                ? 'bg-primary/10 text-primary'
                : 'text-text-muted hover:text-text',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA + phone -->
    <div class="hidden items-center gap-4 lg:flex">
      {client.license && (
        <span class="rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-text-muted">
          {client.license}
        </span>
      )}
      <a
        href={switchHref}
        class="rounded-md border border-border px-2.5 py-1 text-xs font-semibold text-text-muted transition-colors hover:border-primary hover:text-primary"
        aria-label={lang === 'en' ? 'View this page in Polish' : 'Zobacz tę stronę po angielsku'}
      >
        {switchLabel}
      </a>
      <a
        href={`tel:${client.phoneForTel}`}
        class="text-sm font-semibold text-text hover:text-primary transition-colors"
      >
        {client.phoneFormatted}
      </a>
      <a
        href={contactHref}
        class="inline-flex min-h-[44px] items-center rounded-md bg-accent px-5 py-2.5 text-sm font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {quoteLabel}
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md text-text-muted hover:bg-surface lg:hidden"
    >
      <span class="sr-only">Toggle menu</span>
      <svg id="menu-icon-open" class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="hidden size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-background px-4 pb-6 pt-2 lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
      {nav.map(({ label, href, children }) => {
        const isActive =
          currentPath === href ||
          (href !== '/' && currentPath.startsWith(href)) ||
          (children?.some((c) => currentPath === c.href || currentPath.startsWith(c.href)) ?? false);

        if (children) {
          return (
            <div class="mobile-dropdown">
              <button
                type="button"
                aria-expanded="false"
                class:list={[
                  'mobile-dropdown-toggle flex w-full items-center justify-between rounded-md px-3 py-3 text-base font-medium transition-colors',
                  isActive
                    ? 'bg-primary/10 text-primary'
                    : 'text-text-muted hover:text-text hover:bg-surface',
                ]}
              >
                {label}
                <svg class="mobile-dropdown-icon size-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="mobile-dropdown-panel hidden flex-col gap-1 pl-4">
                <a
                  href={href}
                  class:list={[
                    'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                    currentPath === href ? 'bg-primary/10 text-primary' : 'text-text-muted hover:text-text hover:bg-surface',
                  ]}
                >
                  {fullOfferLabel}
                </a>
                {children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                      currentPath === child.href || currentPath.startsWith(child.href)
                        ? 'bg-primary/10 text-primary'
                        : 'text-text-muted hover:text-text hover:bg-surface',
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          );
        }

        return (
          <a
            href={href}
            class:list={[
              'rounded-md px-3 py-3 text-base font-medium transition-colors',
              isActive
                ? 'bg-primary/10 text-primary'
                : 'text-text-muted hover:text-text hover:bg-surface',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <div class="mt-4 flex flex-col gap-3 border-t border-border pt-4">
      <a
        href={switchHref}
        class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text"
        aria-label={lang === 'en' ? 'View this page in Polish' : 'Zobacz tę stronę po angielsku'}
      >
        <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.6 9h16.8M3.6 15h16.8M11.5 3a17 17 0 000 18M12.5 3a17 17 0 010 18" />
        </svg>
        {lang === 'en' ? 'Polski (PL)' : 'English (EN)'}
      </a>
      <a
        href={`tel:${client.phoneForTel}`}
        class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text"
      >
        <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {client.phoneFormatted}
      </a>
      <a
        href={contactHref}
        class="flex min-h-[44px] items-center justify-center rounded-md bg-accent px-5 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90"
      >
        {quoteLabel}
      </a>
      {client.license && (
        <p class="px-3 pt-1 text-xs text-text-muted">{client.license}</p>
      )}
    </div>
  </div>
</header>

<script>
  (() => {
    const headerEl = document.querySelector('header');
    const btnEl = document.getElementById('menu-toggle');
    const menuEl = document.getElementById('mobile-menu');
    const iconOpenEl = document.getElementById('menu-icon-open');
    const iconCloseEl = document.getElementById('menu-icon-close');

    if (!headerEl || !btnEl || !menuEl || !iconOpenEl || !iconCloseEl) return;

    const header = /** @type {HTMLElement} */ (headerEl);
    const btn = /** @type {HTMLButtonElement} */ (btnEl);
    const menu = /** @type {HTMLElement} */ (menuEl);
    const iconOpen = /** @type {HTMLElement} */ (iconOpenEl);
    const iconClose = /** @type {HTMLElement} */ (iconCloseEl);
    if (header.dataset.menuInit === 'true') return;
    header.dataset.menuInit = 'true';

    const activeClasses = ['bg-primary/10', 'text-primary'];
    const inactiveDesktop = ['text-text-muted', 'hover:text-text'];
    const inactiveMobile = ['text-text-muted', 'hover:text-text', 'hover:bg-surface'];

    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

    const setMenuOpen = (nextOpen: boolean) => {
      // Hard stop: hamburger/drawer behavior is mobile-only.
      if (isDesktop()) nextOpen = false;
      btn.setAttribute('aria-expanded', String(nextOpen));
      menu.classList.toggle('hidden', !nextOpen);
      iconOpen.classList.toggle('hidden', nextOpen);
      iconClose.classList.toggle('hidden', !nextOpen);
    };

    function syncActiveLinks() {
      const path = window.location.pathname;
      const desktopLinks = header.querySelectorAll('nav[aria-label="Primary navigation"] a');
      const mobileLinks = header.querySelectorAll('#mobile-menu nav a');

      desktopLinks.forEach((link) => {
        const href = link.getAttribute('href') || '';
        const isActive = href === path || (href !== '/' && path.startsWith(href));
        link.classList.toggle(activeClasses[0], isActive);
        link.classList.toggle(activeClasses[1], isActive);
        link.classList.toggle(inactiveDesktop[0], !isActive);
        link.classList.toggle(inactiveDesktop[1], !isActive);
        if (isActive) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });

      mobileLinks.forEach((link) => {
        const href = link.getAttribute('href') || '';
        const isActive = href === path || (href !== '/' && path.startsWith(href));
        link.classList.toggle(activeClasses[0], isActive);
        link.classList.toggle(activeClasses[1], isActive);
        link.classList.toggle(inactiveMobile[0], !isActive);
        link.classList.toggle(inactiveMobile[1], !isActive);
        link.classList.toggle(inactiveMobile[2], !isActive);
        if (isActive) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
    }

    btn.addEventListener('click', () => {
      if (isDesktop()) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isOpen);
    });

    menu.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const toggle = target.closest('.mobile-dropdown-toggle');
      if (toggle) {
        const panel = toggle.nextElementSibling;
        const icon = toggle.querySelector('.mobile-dropdown-icon');
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        panel?.classList.toggle('hidden', isOpen);
        panel?.classList.toggle('flex', !isOpen);
        icon?.classList.toggle('rotate-180', !isOpen);
        return;
      }
      if (target.closest('a[href]')) setMenuOpen(false);
    });

    document.addEventListener('astro:before-preparation', () => setMenuOpen(false));
    document.addEventListener('astro:after-swap', () => {
      setMenuOpen(false);
      syncActiveLinks();
    });

    // Ensure mobile drawer can't stay open if viewport changes to desktop.
    window.addEventListener('resize', () => setMenuOpen(false));

    setMenuOpen(false);
    syncActiveLinks();
  })();
</script>
