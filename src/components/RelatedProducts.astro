---
import { plToEn } from '../i18n/page-map';

interface Props {
  current: string;
  lang?: 'pl' | 'en';
}

const { current, lang = 'pl' } = Astro.props;

const productsPl = [
  { href: '/torby-reklamowe', label: 'Torby reklamowe' },
  { href: '/torby-reklamowe-z-logo', label: 'Torby reklamowe z logo' },
  { href: '/torby-ozdobne', label: 'Torby ozdobne' },
  { href: '/pudelka-prezentowe', label: 'Pudełka prezentowe' },
  { href: '/torby-na-alkohol', label: 'Torby na alkohol' },
  { href: '/torby-eko', label: 'Torby eko' },
  { href: '/torebki-na-prezenty', label: 'Torebki na prezenty' },
  { href: '/torby-reklamowe-premium', label: 'Torby reklamowe Premium' },
  { href: '/kolekcja-lux', label: 'Kolekcja LUX' },
  { href: '/nasze-realizacje', label: 'Nasze realizacje' },
];

const productsEn = [
  { href: plToEn['/torby-reklamowe'], label: 'Promotional paper bags' },
  { href: plToEn['/torby-reklamowe-z-logo'], label: 'Custom logo paper bags' },
  { href: plToEn['/torby-ozdobne'], label: 'Decorative paper bags' },
  { href: plToEn['/pudelka-prezentowe'], label: 'Gift boxes' },
  { href: plToEn['/torby-na-alkohol'], label: 'Wine gift bags' },
  { href: plToEn['/torby-eko'], label: 'Eco-friendly paper bags' },
  { href: plToEn['/torebki-na-prezenty'], label: 'Gift bags' },
  { href: plToEn['/torby-reklamowe-premium'], label: 'Premium paper bags' },
  { href: plToEn['/kolekcja-lux'], label: 'LUX collection' },
  { href: plToEn['/nasze-realizacje'], label: 'Our work' },
];

const products = lang === 'en' ? productsEn : productsPl;
const heading = lang === 'en'
  ? { topper: 'Check out', title: 'You may also like' }
  : { topper: 'Sprawdź również', title: 'Zobacz też' };

const related = products.filter((p) => p.href !== current);
---

<section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mb-8 text-center">
      <span class="text-topper font-bold uppercase tracking-widest text-accent">{heading.topper}</span>
      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">{heading.title}</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {related.map(({ href, label }) => (
        <a
          href={href}
          class="rounded-lg border border-border bg-background p-5 text-center font-heading font-semibold text-text shadow-sm transition-colors hover:border-accent hover:text-accent"
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</section>
