---
/**
 * Base layout — wraps every page.
 *
 * Astro 6 features used:
 *  • <Font />         — built-in font optimizer from astro.config.mjs fonts array
 *  • <ClientRouter /> — client-side navigation with CSS transition animations
 */
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { brand } from '../config/brand';
import { client } from '../data/client';
import FloatingContact from '../components/FloatingContact.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  serviceName?: string;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  schema,
  noindex = false,
  ogType = 'website',
  serviceName,
} = Astro.props;

const pageTitle = title === brand.name || title.includes(brand.name) ? title : `${title} — ${brand.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? brand.url);
const socialImageURL = new URL(image, Astro.site ?? brand.url);
const defaultBusinessImageURL = new URL('/og-image.jpg', Astro.site ?? brand.url);
const businessId = new URL('/#business', Astro.site ?? brand.url).href;

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': businessId,
  name: client.name,
  description: brand.description,
  image: defaultBusinessImageURL.href,
  logo: new URL('/favicon-512.png', Astro.site ?? brand.url).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: client.address.lineOne,
    addressLocality: client.address.city,
    addressRegion: client.address.state,
    postalCode: client.address.zip,
    addressCountry: client.address.country,
  },
  telephone: client.phoneForTel,
  email: client.email,
  url: client.domain,
  foundingDate: '1993',
};

const serviceSchema = serviceName ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonicalURL.href}#service`,
  name: serviceName,
  serviceType: serviceName,
  description,
  url: canonicalURL.href,
  areaServed: {
    '@type': 'Country',
    name: 'Polska',
  },
  provider: {
    '@id': businessId,
  },
} : undefined;

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemas = [defaultSchema, ...(serviceSchema ? [serviceSchema] : []), ...extraSchemas];
---

<html lang={brand.locale.split('_')[0]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={socialImageURL} />
    <meta property="og:locale"      content={brand.locale} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={socialImageURL} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/favicon-512.png" />

    <!-- Fonts -->
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body"    preload />

    <!-- JSON-LD Structured Data -->
    {schemas.map((schemaItem) => (
      <script type="application/ld+json" set:html={JSON.stringify(schemaItem)} />
    ))}

    <!-- FOUC prevention for dark mode -->
    <script is:inline>
      (function(){
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark-mode');
        }
      })();
    </script>

    <slot name="head" />
    <ClientRouter />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-54LVD7WK');</script>
    <!-- End Google Tag Manager -->
  </head>

  <body class="bg-background text-text font-body antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-54LVD7WK"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a
      class="sr-only focus:not-sr-only focus:absolute focus:z-[99999] focus:bg-primary focus:text-primary-fg focus:px-4 focus:py-2 focus:rounded-md"
      href="#main"
    >
      Przejdź do treści głównej
    </a>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />

    <FloatingContact />
  </body>
</html>
