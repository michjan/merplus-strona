---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import bannerBg from '../assets/images/banner-bg.jpg';
import { brand } from '../config/brand';

interface Props {
  title: string;
  description: string;
  date: Date;
  author?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, date, author = 'Zespół MER Plus', image, imageAlt } = Astro.props;

const formattedDate = date.toLocaleDateString('pl-PL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const pageURL = new URL(Astro.url.pathname, Astro.site ?? brand.url);
const socialImageURL = new URL(image ?? '/og-image.jpg', Astro.site ?? brand.url);
const businessId = new URL('/#business', Astro.site ?? brand.url).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${pageURL.href}#article`,
  headline: title,
  description,
  datePublished: date.toISOString(),
  image: [socialImageURL.href],
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageURL.href,
  },
  author: author === 'Zespół MER Plus'
    ? { '@id': businessId }
    : { '@type': 'Person', name: author },
  publisher: {
    '@id': businessId,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  image={image ?? '/og-image.jpg'}
  ogType="article"
  schema={articleSchema}
>
  <Header slot="header" />

  <!-- Post hero -->
  <section class="relative overflow-hidden bg-primary py-14 sm:py-16 lg:py-20">
    <Image
      src={bannerBg}
      alt=""
      class="absolute inset-0 size-full object-cover"
      widths={[640, 1280, 1920]}
      sizes="100vw"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/70 to-primary/30"></div>
    <div class="relative mx-auto max-w-site px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-primary-fg/60">
          <li><a href="/" class="transition-colors hover:text-primary-fg">Strona główna</a></li>
          <li class="flex items-center gap-1.5">
            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <a href="/blog" class="transition-colors hover:text-primary-fg">Blog</a>
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span aria-current="page" class="text-primary-fg">{title}</span>
          </li>
        </ol>
      </nav>

      <h1 class="font-heading text-h1 font-bold uppercase text-primary-fg">{title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-primary-fg/70">
        <span>{author}</span>
        <span aria-hidden="true">&bull;</span>
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </div>
    </div>
  </section>

  <!-- Post content -->
  <section class="py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      {image && (
        <img
          src={image}
          alt={imageAlt ?? title}
          width="1200"
          height="800"
          loading="eager"
          class="mb-8 w-full rounded-lg object-cover shadow-lg"
        />
      )}
      <article class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:uppercase prose-a:text-primary-light hover:prose-a:text-primary">
        <slot />
      </article>

      <div class="mt-10 border-t border-border pt-6">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-primary-light"
        >
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Powrót do bloga
        </a>
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
