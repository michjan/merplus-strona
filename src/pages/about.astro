---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import storyImage from '../assets/images/gallery/torba-optyczna-new-optica.jpg';

const values = [
  { title: 'Doświadczenie', description: 'Ponad 30 lat na rynku produkcji opakowań papierowych — wiedza i technologia sprawdzona przez lata.' },
  { title: 'Własna produkcja', description: 'Wszystkie torby i opakowania powstają w naszym zakładzie, dzięki czemu mamy pełną kontrolę nad jakością i terminami.' },
  { title: 'Elastyczność', description: 'Realizujemy zarówno małe, indywidualne zamówienia, jak i duże nakłady produkcyjne dla firm.' },
];
---

<BaseLayout title="O nas" description={`Poznaj ${brand.name} — naszą historię, doświadczenie i podejście do jakości.`}>
  <Header slot="header" />

  <Banner title="O nas" />

  <!-- Story -->
  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src={storyImage}
          alt="Torba papierowa wykonana przez MER Plus"
          width={800}
          height={600}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Nasza historia</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Tradycja, jakość i pasja do rzemiosła</h2>
        <p class="text-text-muted leading-relaxed">
          MER Plus działa na rynku od ponad 30 lat. To, co zaczęło się jako niewielka pracownia, rozwinęło się w sprawnie działający zakład produkcyjny, który dziś dostarcza torby papierowe i opakowania reklamowe firmom i klientom indywidualnym w całej Polsce.
        </p>
        <p class="text-text-muted leading-relaxed">
          Łączymy doświadczenie i nowoczesną produkcję z ręcznym wykończeniem — szczególnie w przypadku toreb ozdobnych i prezentowych. Dzięki własnemu zakładowi możemy elastycznie podejść do każdego zamówienia, niezależnie od jego wielkości.
        </p>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Dlaczego my</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Co nas wyróżnia</h2>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        {values.map(({ title, description }) => (
          <div class="rounded-lg bg-background p-6 shadow-sm">
            <h3 class="font-heading text-lg font-semibold text-text">{title}</h3>
            <p class="mt-2 text-sm text-text-muted leading-relaxed">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
