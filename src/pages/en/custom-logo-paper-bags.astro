---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Banner from '../../components/Banner.astro';
import CTA from '../../components/CTA.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import { Image } from 'astro:assets';
import { plToEn } from '../../i18n/page-map';
import img1 from '../../assets/images/gallery/torba-reklamowa-new-optica.jpg';
import img2 from '../../assets/images/gallery/torby-detale-wykonczenia.jpg';

const faqs = [
  {
    question: 'How do I get my logo printed on a paper bag?',
    answer: 'Just send us your logo file (vector format preferred) along with the bag format and color. We\'ll pick the right printing technique — screen printing, offset printing, or embossing — depending on the design and order size.',
  },
  {
    question: 'Is the logo printing on a promotional bag durable?',
    answer: 'Yes, all the printing techniques we use ensure color durability and abrasion resistance, even with heavy bag use.',
  },
  {
    question: "I don't have a finished graphic design — can MER Plus help?",
    answer: "Yes, we help fit your logo to the bag format and advise on which printing technique and color scheme will best match your brand identity.",
  },
  {
    question: 'What is the minimum order for bags with a logo?',
    answer: "We don't require a large minimum order — thanks to our own production facility, we handle both small test batches and large runs for retail chains.",
  },
  {
    question: 'What colors of paper bags can I choose to match my company logo?',
    answer: "Bags are available in many colors, including natural kraft paper and colors matched to a Pantone palette — so the bag matches your brand's style guide.",
  },
];
---

<BaseLayout
  title="Custom Logo Paper Bags | MER Plus"
  description="Paper bags printed with your company logo — full customization, various printing techniques and colors. Delivery from 3 days, no minimum. Free quote."
  serviceName="Manufacturing of custom logo paper bags"
>
  <Header slot="header" lang="en" />

  <Banner title="Custom Logo Paper Bags" parent={{ label: 'Products', href: plToEn['/services'] }} lang="en" />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image src={img1} alt="Paper bag printed with a company logo" width={800} height={600} loading="eager" class="size-full object-cover" />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Customization</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">A logo bag that stays in the customer's memory</h2>
        <p class="text-text-muted leading-relaxed">
          A company logo placed on a paper bag is more than a graphic element — it's a business card that the customer carries down the street, to the office, or home. A well-made logo bag strengthens brand recognition, highlights its character, and shows the company pays attention to detail — even the details that seem minor at first glance.
        </p>
        <p class="text-text-muted leading-relaxed">
          At MER Plus, we customize every logo bag individually — in terms of paper color, format, handle type, and printing technique. Thanks to our own production, we can handle both small test orders and large runs for retail chains or manufacturing companies.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Printing techniques</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">How we print logos on bags</h2>
      </div>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        <div class="rounded-lg bg-background p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-text">Screen printing</h3>
          <p class="mt-2 text-text-muted leading-relaxed">Durable, bold printing ideal for larger runs and simple, strong logos.</p>
        </div>
        <div class="rounded-lg bg-background p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-text">Offset printing</h3>
          <p class="mt-2 text-text-muted leading-relaxed">High-quality detail and color reproduction — works well for more complex graphic designs.</p>
        </div>
        <div class="rounded-lg bg-background p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-text">Embossing and hot stamping</h3>
          <p class="mt-2 text-text-muted leading-relaxed">An elegant logo finish — raised embossing or gold/silver details for premium brands.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="space-y-5 lg:order-2">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Client examples</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Who we've worked with</h2>
        <p class="text-text-muted leading-relaxed">
          We produce logo bags for companies across many industries — from building materials manufacturers to retail chains, cosmetics brands, and specialty shops. We treat every order individually, matching colors and finish to the brand's style guide.
        </p>
        <p class="text-text-muted leading-relaxed">
          If you run a local business and need a smaller batch of bags to get started, we can help with that too — we don't require a large minimum order, which sets us apart from many high-volume manufacturers.
        </p>
      </div>
      <div class="overflow-hidden rounded-lg shadow-lg lg:order-1">
        <Image src={img2} alt="Finishing details of printed paper bags" width={800} height={600} loading="lazy" class="size-full object-cover" />
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Frequently Asked Questions</h2>
      </div>
      <div class="space-y-3">
        {faqs.map(({ question, answer }) => (
          <details class="group rounded-lg border border-border bg-background p-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-h3 font-semibold text-text">
              {question}
              <svg class="size-5 shrink-0 text-primary transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </summary>
            <p class="mt-3 text-text-muted leading-relaxed">{answer}</p>
          </details>
        ))}
      </div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    })} />
  </section>

  <CTA
    lang="en"
    title="Order bags with your company logo"
    description="Send us your logo and order details — we'll prepare a free quote and a production proposal."
  />

  <RelatedProducts current={plToEn['/torby-reklamowe-z-logo']} lang="en" />

  <Footer slot="footer" lang="en" />
</BaseLayout>
