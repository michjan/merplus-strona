---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Banner from '../../components/Banner.astro';
import CTA from '../../components/CTA.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import { Image } from 'astro:assets';
import { plToEn } from '../../i18n/page-map';
import img1 from '../../assets/images/gallery/torby-krowki-witryna.jpg';
---

<BaseLayout
  title="Gift Baskets — Custom Made to Order | MER Plus"
  description="Custom-made gift baskets ready to hand over — for corporate gifts, holidays, and special occasions. Over 30 years of packaging experience. Free quote."
  serviceName="Custom-made gift baskets"
>
  <Header slot="header" lang="en" />

  <Banner title="Gift Baskets" parent={{ label: 'Products', href: plToEn['/services'] }} lang="en" />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image src={img1} alt="Gift basket made by MER Plus" width={800} height={600} loading="eager" class="size-full object-cover" />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Ready to hand over</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">A gift basket ready to hand over</h2>
        <p class="text-text-muted leading-relaxed">
          We put together gift baskets to order — from selecting the basket and filling material to the final arrangement of products. The finished basket is fully assembled and ready to give, without any extra effort on your part.
        </p>
        <p class="text-text-muted leading-relaxed">
          We tailor the size, shape, and style of the basket to the occasion and the products it will contain, so the final result looks coherent and elegant.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Applications</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Corporate and holiday gifts</h2>
      </div>
      <p class="mx-auto max-w-3xl text-text-muted leading-relaxed">
        Gift baskets work well as corporate gifts for clients and partners, as holiday gifts for employees, and as personalized presents for special occasions. We prepare orders of various sizes — from a single custom basket to larger batches for a whole team or client base.
      </p>
    </div>
  </section>

  <section class="py-8">
    <div class="mx-auto max-w-site px-4 text-center sm:px-6">
      <p class="text-sm text-text-muted">
        Read more on our blog:
        <a href="/en/blog/creative-gift-wrapping-ideas" class="font-semibold text-primary underline-offset-2 hover:underline">Creative Ways to Wrap a Gift</a>
      </p>
    </div>
  </section>

  <CTA
    lang="en"
    title="Ask about gift baskets"
    description="Tell us about the occasion and the products you'd like included — we'll prepare a free quote for a custom gift basket."
  />

  <RelatedProducts current={plToEn['/kosze-prezentowe']} lang="en" />

  <Footer slot="footer" lang="en" />
</BaseLayout>
