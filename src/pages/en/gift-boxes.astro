---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Banner from '../../components/Banner.astro';
import CTA from '../../components/CTA.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import { Image } from 'astro:assets';
import { plToEn } from '../../i18n/page-map';
import img1 from '../../assets/images/gallery/torby-krowki-witryna.jpg';
import img2 from '../../assets/images/gallery/torba-premium-siklienka.jpg';
---

<BaseLayout
  title="Custom Gift Boxes | MER Plus"
  description="Custom gift boxes — paper packaging in any size and color. In-house production, delivery from 3 days. Free quote."
  serviceName="Manufacturing of custom gift boxes"
>
  <Header slot="header" lang="en" />

  <Banner title="Custom Gift Boxes" parent={{ label: 'Products', href: plToEn['/services'] }} lang="en" />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image src={img1} alt="Custom gift boxes on display" width={800} height={600} loading="eager" class="size-full object-cover" />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Custom boxes</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Paper gift boxes tailored to your needs</h2>
        <p class="text-text-muted leading-relaxed">
          Alongside paper bags, our range also includes gift boxes made to order. This is a solution especially valued by shops, confectioneries, cosmetics companies, and event organizers who need packaging in a specific size, color, and finish — not available in a standard, off-the-shelf wholesale range.
        </p>
        <p class="text-text-muted leading-relaxed">
          We manufacture boxes from durable cardboard and paper, with the option to add printing, ribbons, corner reinforcements, or interior inserts. Thanks to our own production, we can prepare both small test batches and larger runs for regular customers.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Capabilities</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">What we can make for you</h2>
      </div>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        <div class="rounded-lg bg-background p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-text">Any size</h3>
          <p class="mt-2 text-text-muted leading-relaxed">Boxes designed for a specific product — from jewelry and cosmetics to sweets and corporate gifts.</p>
        </div>
        <div class="rounded-lg bg-background p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-text">Printing and colors</h3>
          <p class="mt-2 text-text-muted leading-relaxed">Boxes in your brand colors, with a logo or a seasonal motif, such as a holiday design.</p>
        </div>
        <div class="rounded-lg bg-background p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-text">Finishing</h3>
          <p class="mt-2 text-text-muted leading-relaxed">Ribbons, inserts, reinforcements, and other decorative elements added by hand.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="space-y-5 lg:order-2">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Who it's for</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Gift boxes for businesses and individual customers</h2>
        <p class="text-text-muted leading-relaxed">
          MER Plus gift boxes are used both by companies that need large volumes for the holiday season and by individual customers looking for a single, elegant package for a special gift. Regardless of order size, we approach every project individually and help choose the right material, color, and finish.
        </p>
        <p class="text-text-muted leading-relaxed">
          If you need a box matched to a specific product or campaign — get in touch, and we'll prepare a proposal along with a free quote.
        </p>
      </div>
      <div class="overflow-hidden rounded-lg shadow-lg lg:order-1">
        <Image src={img2} alt="Custom premium gift box" width={800} height={600} loading="lazy" class="size-full object-cover" />
      </div>
    </div>
  </section>

  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">For every occasion</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Gift boxes for any occasion</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Whatever the event, we'll match the box's size, color, and finish to the character of the occasion.
        </p>
      </div>
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" role="list">
        {['Weddings', 'First Communion', 'Christenings', 'Baby showers', 'Birthdays', 'Christmas & holidays', "Valentine's Day", "Mother's / Father's Day", 'Corporate gifts', 'Store openings / events', 'Anniversaries', 'Customer thank-you gifts'].map((occasion) => (
          <li class="rounded-lg bg-background p-4 text-center text-sm font-semibold text-text shadow-sm">
            {occasion}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTA
    lang="en"
    title="Order custom-sized gift boxes"
    description="Give us the dimensions and quantity — we'll prepare a free quote for boxes matched to your product."
  />

  <RelatedProducts current={plToEn['/pudelka-prezentowe']} lang="en" />

  <Footer slot="footer" lang="en" />
</BaseLayout>
