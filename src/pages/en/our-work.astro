---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Banner from '../../components/Banner.astro';
import CTA from '../../components/CTA.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import { Image } from 'astro:assets';
import { plToEn } from '../../i18n/page-map';
import premiumImg from '../../assets/images/gallery/torba-premium-revitalash.jpg';
import kraftImg from '../../assets/images/gallery/torba-eko-orska.jpg';
import decorImg from '../../assets/images/gallery/torba-ozdobna-prouve.jpg';
import goldImg from '../../assets/images/gallery/torba-premium-siklienka.jpg';
import wineImg from '../../assets/images/gallery/torba-na-wino-gautier.jpg';
import corrugatedImg from '../../assets/images/gallery/torby-detale-wykonczenia.jpg';

const categories = [
  { name: 'Premium', count: '55 projects', img: premiumImg, alt: 'Premium bag project' },
  { name: 'Kraft', count: '18 projects', img: kraftImg, alt: 'Kraft bag project' },
  { name: 'Decorative', count: '6 projects', img: decorImg, alt: 'Decorative bag project' },
  { name: 'Gold White Collection', count: '6 projects', img: goldImg, alt: 'Project from the Gold White collection' },
  { name: 'Hej Zakopane', count: '6 projects', img: wineImg, alt: 'Project from the Hej Zakopane collection' },
  { name: 'Corrugated Cardboard', count: '1 project', img: corrugatedImg, alt: 'Corrugated cardboard box project' },
];
---

<BaseLayout
  title="Our Work — Custom Paper Bags | MER Plus"
  description="See over 90 completed paper bag projects — from elegant Premium to eco-friendly Kraft. Check our portfolio and request a quote."
  serviceName="Custom paper bag manufacturing to order"
>
  <Header slot="header" lang="en" />

  <Banner title="Our Work" parent={{ label: 'Products', href: plToEn['/services'] }} lang="en" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Portfolio</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Over 90 completed projects</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          From elegant Premium bags, through eco-friendly Kraft, to decorative seasonal collections — see examples of projects we've completed for our customers.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((cat) => (
          <div class="overflow-hidden rounded-lg border border-border bg-background shadow-sm">
            <Image src={cat.img} alt={cat.alt} width={600} height={450} loading="lazy" class="h-48 w-full object-cover" />
            <div class="p-5">
              <h3 class="font-heading text-lg font-semibold text-text">{cat.name}</h3>
              <p class="mt-1 text-sm text-text-muted">{cat.count}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA
    lang="en"
    title="Let's bring your project to life"
    description="Share your packaging idea — drawing on our experience, we'll help you choose the material, color, and finish, and prepare a free quote."
  />

  <RelatedProducts current={plToEn['/nasze-realizacje']} lang="en" />

  <Footer slot="footer" lang="en" />
</BaseLayout>
