---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
import { Image } from 'astro:assets';
import img1 from '../assets/images/gallery/torby-krowki-witryna.jpg';
---

<BaseLayout
  title="Kosze Prezentowe | MER Plus"
  description="Kosze prezentowe od Mer Plus — gotowe zestawy i indywidualne komponowanie na upominki firmowe i prywatne. Zapytaj o bezpłatną wycenę."
  serviceName="Przygotowanie koszy prezentowych na zamówienie"
>
  <Header slot="header" />

  <Banner title="Kosze prezentowe" parent={{ label: 'Oferta', href: '/services' }} />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image src={img1} alt="Kosz prezentowy z produktami" width={800} height={600} loading="eager" class="size-full object-cover" />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Kosze prezentowe</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Upominek gotowy do wręczenia</h2>
        <p class="text-text-muted leading-relaxed">
          Kosze prezentowe to wygodne rozwiązanie dla firm i osób prywatnych, które chcą przygotować rozbudowany, atrakcyjnie zaprezentowany upominek bez samodzielnego kompletowania opakowania. Pomagamy dobrać wielkość, formę i wykończenie kosza do zawartości i okazji — od świąt firmowych, po prezenty dla klientów i pracowników.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Zastosowanie</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Prezenty firmowe i świąteczne</h2>
      </div>
      <p class="mx-auto max-w-3xl text-center text-text-muted leading-relaxed">
        Kosze prezentowe najczęściej zamawiane są na potrzeby świąt firmowych, podarunków dla partnerów biznesowych oraz okazjonalnych akcji marketingowych. Doradzimy w doborze wykończenia — od klasycznego wiklinowego kosza, po nowocześniejsze, papierowe formy zgodne z resztą naszej oferty ekologicznej.
      </p>
    </div>
  </section>

  <section class="py-8">
    <div class="mx-auto max-w-site px-4 text-center sm:px-6">
      <p class="text-sm text-text-muted">
        Poczytaj więcej na blogu:
        <a href="/blog/jak-kreatywnie-zapakowac-prezent" class="font-semibold text-primary underline-offset-2 hover:underline">Jak kreatywnie zapakować prezent?</a>
      </p>
    </div>
  </section>

  <CTA
    title="Zapytaj o kosze prezentowe"
    description="Napisz, na jaką okazję szukasz kosza prezentowego — pomożemy dobrać rozmiar i wykończenie oraz przygotujemy wycenę."
  />

  <RelatedProducts current="/kosze-prezentowe" />

  <Footer slot="footer" />
</BaseLayout>
