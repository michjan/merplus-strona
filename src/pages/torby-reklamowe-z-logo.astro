---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import RelatedProducts from '../components/RelatedProducts.astro';
import { Image } from 'astro:assets';
import img1 from '../assets/images/gallery/torba-reklamowa-new-optica.jpg';
import img2 from '../assets/images/gallery/torby-detale-wykonczenia.jpg';
const faqs = [
  {
    question: 'Jak nadrukować logo na papierowej torbie?',
    answer: 'Wystarczy przesłać nam plik z logo (najlepiej w formacie wektorowym) oraz informacje o formacie i kolorze torby. Dobierzemy technikę nadruku — sitodruk, druk offsetowy lub tłoczenie — w zależności od projektu i wielkości zamówienia.',
  },
  {
    question: 'Czy nadruk logo na torbie reklamowej jest trwały?',
    answer: 'Tak, wszystkie stosowane przez nas techniki nadruku zapewniają trwałość kolorów i odporność na ścieranie, nawet przy intensywnym użytkowaniu torby.',
  },
  {
    question: 'Nie mam gotowego projektu graficznego — czy MER Plus pomoże?',
    answer: 'Tak, pomagamy dopasować przesłane logo do formatu torby oraz podpowiadamy, jaka technika nadruku i kolorystyka będą najlepiej współgrać z identyfikacją wizualną Twojej marki.',
  },
  {
    question: 'Jakie jest minimalne zamówienie toreb z logo?',
    answer: 'Nie wymagamy dużego minimum zamówienia — dzięki własnej produkcji realizujemy zarówno niewielkie partie testowe, jak i duże nakłady dla sieci sklepów.',
  },
  {
    question: 'Jakie kolory toreb papierowych można wybrać pod logo firmy?',
    answer: 'Torby dostępne są w wielu kolorach, w tym w naturalnym papierze kraft oraz kolorach dopasowanych do palety Pantone — tak, aby torba była zgodna z księgą znaku Twojej marki.',
  },
];
---

<BaseLayout
  title="Torby Reklamowe z Logo Firmy | MER Plus"
  description="Torby papierowe z nadrukiem logo firmy — pełna personalizacja, różne techniki nadruku i kolory. Realizacja od 3 dni, bez minimum. Bezpłatna wycena."
  serviceName="Produkcja toreb reklamowych z logo firmy"
>
  <Header slot="header" />

  <Banner title="Torby reklamowe z logo firmy" parent={{ label: 'Oferta', href: '/services' }} />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image src={img1} alt="Torba papierowa z nadrukiem logo firmowego" width={800} height={600} loading="eager" class="size-full object-cover" />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Personalizacja</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Torba z logo, która zostaje w pamięci klienta</h2>
        <p class="text-text-muted leading-relaxed">
          Logo firmy umieszczone na papierowej torbie to coś więcej niż element graficzny — to wizytówka, którą klient niesie ze sobą przez ulicę, do biura czy domu. Dobrze wykonana torba z logo wzmacnia rozpoznawalność marki, podkreśla jej charakter i pokazuje, że firma przykłada uwagę do detali — także tych, które na pierwszy rzut oka wydają się drobne.
        </p>
        <p class="text-text-muted leading-relaxed">
          W MER Plus każdą torbę reklamową z logo dopasowujemy indywidualnie — pod kątem koloru papieru, formatu, rodzaju uchwytów oraz techniki nadruku. Dzięki własnej produkcji jesteśmy w stanie zrealizować zarówno niewielkie zamówienia testowe, jak i duże nakłady dla sieci sklepów czy firm produkcyjnych.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Techniki nadruku</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Jak nadrukowujemy logo na torbach</h2>
      </div>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        <div class="rounded-lg bg-background p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-text">Sitodruk</h3>
          <p class="mt-2 text-text-muted leading-relaxed">Trwały, intensywny nadruk idealny do większych nakładów i prostych, mocnych logotypów.</p>
        </div>
        <div class="rounded-lg bg-background p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-text">Druk offsetowy</h3>
          <p class="mt-2 text-text-muted leading-relaxed">Wysoka jakość detali i kolorów — sprawdza się przy bardziej złożonych projektach graficznych.</p>
        </div>
        <div class="rounded-lg bg-background p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-text">Tłoczenie i hot stamping</h3>
          <p class="mt-2 text-text-muted leading-relaxed">Eleganckie wykończenie logo — wypukłe tłoczenie lub złote/srebrne detale dla marek premium.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="space-y-5 lg:order-2">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Przykłady realizacji</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Z kim już współpracowaliśmy</h2>
        <p class="text-text-muted leading-relaxed">
          Wykonujemy torby z logo dla firm z różnych branż — od producentów materiałów budowlanych, przez sieci handlowe, aż po marki kosmetyczne i sklepy specjalistyczne. Każde zamówienie traktujemy indywidualnie, dopasowując kolorystykę i wykończenie do wytycznych marki (brand book).
        </p>
        <p class="text-text-muted leading-relaxed">
          Jeśli prowadzisz lokalny biznes i potrzebujesz mniejszej partii toreb na start, również się tym zajmiemy — nie wymagamy dużego minimum zamówienia, co odróżnia nas od wielu producentów wielkonakładowych.
        </p>
      </div>
      <div class="overflow-hidden rounded-lg shadow-lg lg:order-1">
        <Image src={img2} alt="Detale wykończenia toreb papierowych z nadrukiem" width={800} height={600} loading="lazy" class="size-full object-cover" />
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Najczęściej zadawane pytania</h2>
      </div>
      <div class="space-y-3">
        {faqs.map(({ question, answer }) => (
          <details class="group rounded-lg border border-border bg-background p-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-h3 font-semibold text-text">
              {question}
              <svg class="size-5 shrink-0 text-primary transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </summary>
            <p class="mt-3 text-text-muted leading-relaxed">{answer}</p>
          </details>
        ))}
      </div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    })} />
  </section>

  <section class="py-8">
    <div class="mx-auto max-w-site px-4 text-center sm:px-6">
      <p class="text-sm text-text-muted">
        Poczytaj więcej na blogu:
        <a href="/blog/torby-papierowe-z-logo-jako-propozycja-dla-firm" class="font-semibold text-primary underline-offset-2 hover:underline">Torby papierowe z logo jako propozycja dla firm</a>
      </p>
    </div>
  </section>

  <CTA
    title="Zamów torby z logo Twojej firmy"
    description="Wyślij swoje logo i parametry zamówienia — przygotujemy bezpłatną wycenę oraz propozycję wykonania."
  />

  <RelatedProducts current="/torby-reklamowe-z-logo" />

  <Footer slot="footer" />
</BaseLayout>
