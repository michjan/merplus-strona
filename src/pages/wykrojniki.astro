---

<BaseLayout
  title="Wykrojniki"
  description={`Sprawdź pełną bazę dostępnych wykrojników toreb papierowych ${brand.name}. Gotowe rozmiary pozwalają zaoszczędzić czas i koszty produkcji.`}
>
  <Header slot="header" />

  <Banner title="Wykrojniki" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-3xl text-center lg:mb-14">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Baza wykrojników</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Dostępne rozmiary toreb</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Zachęcamy do korzystania z naszej bazy gotowych wykrojników — pozwala to zaoszczędzić czas i koszty
          związane z wykonaniem nowego wykrojnika. Jeśli wśród poniższych rozmiarów nie znajdą Państwo
          odpowiedniego wymiaru, na zamówienie wykonamy dowolny inny wykrojnik, idealnie dopasowany do
          Państwa produktu.
        </p>
      </div>

      <!-- Search / filter -->
      <div class="mx-auto mb-6 flex max-w-sm flex-col gap-1.5">
        <label for="dieCutSearch" class="text-sm font-medium text-text">Szukaj wymiaru</label>
        <div class="relative">
          <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
          </svg>
          <input
            type="search"
            id="dieCutSearch"
            placeholder="np. 25 lub 1/2"
            class="min-h-[44px] w-full rounded-md border border-border bg-background py-2.5 pl-9 pr-4 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
        </div>
        <p class="text-xs text-text-muted">
          Wpisz np. szerokość torby, aby szybko znaleźć pasujące wykrojniki. Liczba widocznych pozycji: <span id="dieCutCount" class="font-semibold text-text">{dieCuts.length}</span> z {dieCuts.length}.
        </p>
      </div>

      <!-- Mobile cards -->
      <div class="mb-3 grid grid-cols-1 gap-2 sm:hidden">
        {dieCuts.map(([width, height, base], i) => (
          <div
            data-row
            class:list={[
              'flex items-center justify-between gap-3 rounded-lg border border-border px-4 py-3',
              i % 2 === 1 ? 'bg-background-alt' : 'bg-background',
            ]}
          >
            <div class="flex items-baseline gap-1.5">
              <span class="font-heading text-xl font-bold text-text">{width}</span>
              <span class="text-sm font-medium text-text-muted">×</span>
              <span class="font-heading text-xl font-bold text-text">{height}</span>
              <span class="text-xs font-medium uppercase text-text-muted">cm</span>
            </div>
            <div class="shrink-0 rounded-md bg-primary/10 px-3 py-1.5 text-right">
              <span class="block text-[10px] font-semibold uppercase tracking-wide text-primary-light">Denko</span>
              <span class="text-base font-bold text-primary-light">{base} cm</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Desktop / tablet table -->
      <div class="hidden overflow-hidden rounded-lg border border-border shadow-sm sm:block">
        <div class="max-h-[32rem] overflow-y-auto">
          <table class="w-full border-collapse text-base">
            <thead class="sticky top-0 z-10 bg-primary text-primary-fg">
              <tr>
                <th scope="col" class="px-4 py-3 text-left font-heading font-semibold uppercase tracking-wide">Szerokość (cm)</th>
                <th scope="col" class="px-4 py-3 text-left font-heading font-semibold uppercase tracking-wide">Wysokość torby (cm)</th>
                <th scope="col" class="px-4 py-3 text-left font-heading font-semibold uppercase tracking-wide">Szerokość denka (cm)</th>
              </tr>
            </thead>
            <tbody>
              {dieCuts.map(([width, height, base], i) => (
                <tr
                  data-row
                  class:list={[
                    'border-t border-border transition-colors hover:bg-primary/5',
                    i % 2 === 1 && 'bg-background-alt',
                  ]}
                >
                  <td class="px-4 py-2 text-lg font-bold text-text">{width}</td>
                  <td class="px-4 py-2 text-lg text-text-muted">{height}</td>
                  <td class="px-4 py-2 text-lg text-text-muted">{base}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <p id="dieCutEmpty" class="hidden p-6 text-center text-text-muted">
        Brak wykrojników pasujących do wpisanej frazy.
      </p>

      <!-- Custom die-cut note -->
      <div class="mx-auto mt-10 max-w-3xl rounded-lg border border-border bg-background-alt p-6 text-center sm:p-8">
        <h3 class="font-heading text-h3 font-bold uppercase text-text">Wykrojnik na zamówienie</h3>
        <p class="mt-2 text-text-muted leading-relaxed">
          Nie znaleźli Państwo odpowiedniego rozmiaru? W przystępnej cenie wykonamy dowolny inny wykrojnik,
          dopasowany idealnie do Twojego produktu. Skontaktuj się z nami, aby omówić szczegóły.
        </p>
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>

<script>
  const input = document.getElementById('dieCutSearch') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('div[data-row]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('tr[data-row]'));
  const countEl = document.getElementById('dieCutCount');
  const emptyEl = document.getElementById('dieCutEmpty');

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;

    for (let i = 0; i < rows.length; i++) {
      const matches = !query || rows[i].textContent!.toLowerCase().includes(query);
      rows[i].classList.toggle('hidden', !matches);
      cards[i]?.classList.toggle('hidden', !matches);
      if (matches) visible++;
    }

    if (countEl) countEl.textContent = String(visible);
    emptyEl?.classList.toggle('hidden', visible !== 0);
  });
</script>
